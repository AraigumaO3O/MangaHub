        "enum": [
          "Pendiente",
          "Leyendo",
          "Terminado"
        ],
        "type": "string"
      },
      "LoginDto": {
        "required": [
          "email",
          "password"
        ],
        "type": "object",
        "properties": {
          "email": {
            "minLength": 1,
            "type": "string"
          },
          "password": {
            "minLength": 1,
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "MangaDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "nombre": {
            "type": "string",
            "nullable": true
          },
          "resumen": {
            "type": "string",
            "nullable": true
          },
          "autorId": {
            "type": "integer",
            "format": "int32"
          },
          "autorNombre": {
            "type": "string",
            "nullable": true
          },
          "categoriaId": {
            "type": "integer",
            "format": "int32"
          },
          "categoriaNombre": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false,
        "description": "Datos de un manga que devuelve la API."
      },
      "MangaRequestDto": {
        "required": [
          "nombre"
        ],
        "type": "object",
        "properties": {
          "nombre": {
            "maxLength": 150,
            "minLength": 0,
            "type": "string"
          },
          "resumen": {
            "maxLength": 2000,
            "minLength": 0,
            "type": "string",
            "nullable": true
          },
          "autorId": {
            "maximum": 2147483647,
            "minimum": 1,
            "type": "integer",
            "format": "int32"
          },
          "categoriaId": {
            "maximum": 2147483647,
            "minimum": 1,
            "type": "integer",
            "format": "int32"
          }
        },
        "additionalProperties": false,
        "description": "Datos que se envían para crear o actualizar un manga."
      },
