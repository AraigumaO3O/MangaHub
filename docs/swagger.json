          "capituloActual": {
            "maximum": 100000,
            "minimum": 0,
            "type": "integer",
            "format": "int32"
          }
        },
        "additionalProperties": false,
        "description": "Datos para actualizar el estado de lectura de un manga de la biblioteca."
      },
