      "EntradaRequestDto": {
        "type": "object",
        "properties": {
          "mangaId": {
            "maximum": 2147483647,
            "minimum": 1,
            "type": "integer",
            "format": "int32"
          },
          "estado": {
            "$ref": "#/components/schemas/EstadoLectura"
          },
          "capituloActual": {
            "maximum": 100000,
            "minimum": 0,
            "type": "integer",
            "format": "int32"
          }
        },
        "additionalProperties": false,
        "description": "Datos para agregar un manga a la biblioteca personal."
      },
      "EntradaUpdateDto": {
        "type": "object",
        "properties": {
          "estado": {
            "$ref": "#/components/schemas/EstadoLectura"
